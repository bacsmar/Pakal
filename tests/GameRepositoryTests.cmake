# GameRepositoryTests: a game in a repository of its own adds the engine with add_subdirectory (examples/game_repository,
# docs/GAME_REPOSITORY.md). Configures that folder against this tree and checks what the game's build gets: the player,
# its module, the engine's libraries by name, and none of the engine's examples, tests or tools. Configure only: the
# engine's packages come from this build's vcpkg_installed, bgfx from external/ as built.
#
#   cmake -DPAKAL_ROOT=<tree> -DTEST_DIR=<scratch folder> -DGENERATOR=<generator> [-DMAKE_PROGRAM=<ninja>]
#         [-DTOOLCHAIN=<vcpkg.cmake> -DTRIPLET=<triplet> -DINSTALLED=<vcpkg_installed>] -P GameRepositoryTests.cmake
# The engine's CMake names its tree by PAKAL_ROOT and PAKAL_BINARY_ROOT: CMAKE_SOURCE_DIR and CMAKE_BINARY_DIR are the
# game's folders when the engine is a subdirectory. A block written or merged with them breaks every game's build.
file(GLOB pakal_cmake_files ${PAKAL_ROOT}/CMakeLists.txt ${PAKAL_ROOT}/cmake/*.cmake)
set(found "")
foreach(f ${pakal_cmake_files})
    file(STRINGS ${f} lines REGEX "\\$\\{CMAKE_(SOURCE|BINARY)_DIR\\}")
    foreach(line ${lines})
        string(STRIP "${line}" line)
        file(RELATIVE_PATH rel ${PAKAL_ROOT} ${f})
        string(APPEND found "\n  ${rel}: ${line}")
    endforeach()
endforeach()
if(found)
    message(FATAL_ERROR "FAIL the engine's CMake names CMAKE_SOURCE_DIR or CMAKE_BINARY_DIR (use PAKAL_ROOT, PAKAL_BINARY_ROOT):${found}")
endif()
message("ok   the engine's CMake names its tree by PAKAL_ROOT only")

file(REMOVE_RECURSE ${TEST_DIR})
set(args -S ${PAKAL_ROOT}/examples/game_repository -B ${TEST_DIR} -G ${GENERATOR} -DPAKAL_SOURCE=${PAKAL_ROOT}
    -DCMAKE_BUILD_TYPE=Release)
if(MAKE_PROGRAM)
    list(APPEND args -DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM})
endif()
if(TOOLCHAIN)
    list(APPEND args -DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN} -DVCPKG_TARGET_TRIPLET=${TRIPLET} -DVCPKG_INSTALLED_DIR=${INSTALLED}
        -DVCPKG_MANIFEST_DIR=${PAKAL_ROOT} -DVCPKG_MANIFEST_INSTALL=OFF)
endif()
execute_process(COMMAND ${CMAKE_COMMAND} ${args} RESULT_VARIABLE failed OUTPUT_VARIABLE out ERROR_VARIABLE out)
if(failed)
    message(FATAL_ERROR "FAIL the game's project does not configure with the engine as a subdirectory:\n${out}")
endif()
message("ok   the game's project configures with the engine as a subdirectory")

# the targets its build has (the generator's own list)
if(GENERATOR MATCHES "Ninja")
    if(NOT MAKE_PROGRAM)
        set(MAKE_PROGRAM ninja)
    endif()
    execute_process(COMMAND ${MAKE_PROGRAM} -C ${TEST_DIR} -t targets all RESULT_VARIABLE failed OUTPUT_VARIABLE targets
        ERROR_VARIABLE targets)
else()
    execute_process(COMMAND ${CMAKE_COMMAND} --build ${TEST_DIR} --target help RESULT_VARIABLE failed OUTPUT_VARIABLE targets
        ERROR_VARIABLE targets)
endif()
if(failed)
    message(FATAL_ERROR "FAIL the build's targets are not listed:\n${targets}")
endif()
set(failures 0)
foreach(wanted ExampleModule ExampleModuleData PakalPlayer Pakal PakalTopDownView PakalShaders)
    if(NOT targets MATCHES "(^|[\n ])${wanted}[:\n ]")
        message("FAIL the game's build has no ${wanted}")
        math(EXPR failures "${failures} + 1")
    else()
        message("ok   the game's build has ${wanted}")
    endif()
endforeach()
foreach(unwanted ZombiesModule BrawlerModule QuestArbiterTests CoreTests SimWorldTests pakal-level PakalMeshViewer)
    if(targets MATCHES "(^|[\n ])${unwanted}[:\n ]")
        message("FAIL the engine's ${unwanted} is in the game's build")
        math(EXPR failures "${failures} + 1")
    else()
        message("ok   no ${unwanted} in the game's build")
    endif()
endforeach()
# none of the engine's tests, whatever its name (a test block added without PAKAL_BUILD_TESTS)
string(REGEX MATCHALL "(^|\n)[A-Za-z0-9_]+Tests:" leaked "${targets}")
if(leaked)
    string(REPLACE "\n" " " leaked "${leaked}")
    message("FAIL the engine's tests are in the game's build: ${leaked}")
    math(EXPR failures "${failures} + 1")
else()
    message("ok   no test of the engine's in the game's build")
endif()
# the engine is built inside the game's build folder
if(NOT EXISTS ${TEST_DIR}/pakal/CMakeFiles)
    message("FAIL the engine is not built in the game's build folder (pakal/)")
    math(EXPR failures "${failures} + 1")
endif()
if(failures)
    message(FATAL_ERROR "${failures} failed")
endif()
message("all passed")
