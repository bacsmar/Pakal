/* The look of the game's interface. Sizes in dp (1 dp = 1 pixel at 720 lines, it scales with the screen). */
body {
	font-family: Roboto;
	font-size: 18dp;
	color: #f2f2f2;
	width: 100%;
	height: 100%;
	pointer-events: none;   /* the game gets what is not on a panel or button */
}
.title { font-family: Bangers; letter-spacing: 1dp; }

/* --- HUD --- */
#topbar {
	position: absolute; left: 16dp; top: 12dp; right: 16dp;
	height: 44dp;
}
.chip {
	float: left;
	height: 36dp;
	line-height: 36dp;
	padding: 0 14dp;
	margin-right: 10dp;
	background-color: #000000a0;
	border-radius: 18dp;
	font-size: 20dp;
}
.chip .label { font-family: Bangers; color: #ffcf40; margin-right: 8dp; font-size: 20dp; }
#health_bar {
	display: inline-block;
	width: 120dp; height: 12dp;
	margin-top: 12dp;
	margin-right: 8dp;
	background-color: #ffffff30;
	border-radius: 6dp;
	vertical-align: top;
}
#health_fill { height: 100%; width: 100%; background-color: #4cd964; border-radius: 6dp; }
#health_fill.low { background-color: #ff3b30; }
#money .label { color: #7dff7d; }

#objective_box {
	position: absolute; top: 64dp; left: 16dp;
	padding: 6dp 14dp;
	background-color: #00000080;
	border-radius: 8dp;
}
#objective { font-size: 18dp; white-space: nowrap; }
#timer { font-family: Bangers; font-size: 30dp; color: #ffcf40; }
#boost { color: #6fd8ff; }
#dialog {
	position: absolute; bottom: 120dp; left: 20%; right: 20%;
	text-align: center;
	font-size: 22dp;
	padding: 10dp;
	background-color: #000000a0;
	border-radius: 10dp;
}
#help { position: absolute; bottom: 10dp; left: 16dp; font-size: 14dp; color: #ffffffa0; }
body.touch #help { display: none; }

#pause_button {
	position: absolute; top: 12dp; right: 16dp;
	width: 44dp; height: 44dp;
	line-height: 44dp;
	text-align: center;
	font-family: Bangers; font-size: 26dp;
	background-color: #000000a0;
	border-radius: 22dp;
	pointer-events: auto;
}
#pause_button:hover { background-color: #303030d0; }

/* --- Full-screen panels: pause, down, level complete --- */
#overlay {
	position: absolute; left: 0; top: 0; width: 100%; height: 100%;
	background-color: #000000a8;
	pointer-events: auto;
}
#panel {
	position: absolute; left: 50%; top: 50%;
	width: 640dp;
	transform: translate(-50%, -50%);
	padding: 24dp;
	background-color: #1b1b1ef0;
	border-radius: 14dp;
	border: 2dp #ffcf40;
	text-align: center;
}
#panel_title { font-family: Bangers; font-size: 52dp; color: #ffcf40; }
#panel_text { margin: 6dp 0 8dp 0; font-size: 18dp; color: #d0d0d0; }
#panel_stars img { width: 56dp; height: 56dp; margin: 0 4dp; }
#panel_reward { font-size: 18dp; color: #7dff7d; margin-bottom: 10dp; }
#boosts {
	position: absolute; bottom: 36dp; left: 0; right: 0;
	text-align: center;
}
.boost {
	display: inline-block;
	height: 40dp; line-height: 40dp;
	padding: 0 14dp; margin: 0 5dp;
	font-family: Bangers; font-size: 22dp;
	color: #1b1b1e;
	background-color: #6fd8ffe0;
	border-radius: 20dp;
	pointer-events: auto;
}
.boost:hover { background-color: #a8e8ff; }
.boost .count { color: #1b1b1e; font-size: 18dp; }
body.touch #boosts { bottom: auto; top: 64dp; left: 40%; right: 0; text-align: right; padding-right: 16dp; }
.button {
	margin: 8dp auto;
	width: 300dp;
	height: 50dp;
	line-height: 50dp;
	font-family: Bangers; font-size: 28dp;
	color: #1b1b1e;
	background-color: #ffcf40;
	border-radius: 10dp;
	pointer-events: auto;
}
.button:hover { background-color: #ffe080; }
.button:active { background-color: #d8a820; }
.button.secondary { background-color: #3a3a40; color: #f2f2f2; }

/* The options' rows (the menu's OPTIONS screen and the pause panel) */
.option_row { margin: 10dp 0; text-align: left; }
.option_label { display: inline-block; width: 110dp; font-size: 22dp; color: #b8b8b8; }
.option_row .button { display: inline-block; width: auto; height: 40dp; line-height: 40dp; padding: 0 12dp; margin: 0 0 0 6dp; font-size: 20dp; }
.option_note { font-size: 14dp; color: #9a9a9a; margin-top: 6dp; text-align: left; }
#pause_options { margin-top: 14dp; }
.button.secondary:hover { background-color: #505058; }
.button.poor { background-color: #6b5a26; color: #2a2a2a; }   /* not enough money */

/* --- Loading screen --- */
#loading_screen {
	position: absolute; left: 0; top: 0; width: 100%; height: 100%;
	background-color: #121214;
	decorator: vertical-gradient(#1d1d22 #0b0b0d);
	text-align: center;
}
#loading_title {
	padding-top: 190dp;
	font-size: 76dp;
	color: #ffcf40;
}
#loading_level { font-size: 20dp; color: #b8b8b8; margin-top: 4dp; }
#loading_bar {
	margin: 34dp auto 0 auto;
	width: 520dp; height: 16dp;
	background-color: #ffffff1a;
	border-radius: 8dp;
}
#loading_fill { width: 0%; height: 100%; background-color: #ffcf40; border-radius: 8dp; }
#loading_tip {
	position: absolute; left: 15%; right: 15%; bottom: 60dp;
	font-size: 19dp; color: #d8d8d8;
}
#loading_tip em { color: #ffcf40; font-style: normal; font-family: Bangers; font-size: 22dp; }
