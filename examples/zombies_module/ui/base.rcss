/* What every document needs: RmlUi has no default style for the tags */
body, div, h1, h2, h3, p, button, table, tr, td { display: block; }
img { display: inline-block; }
span, em, strong { display: inline; }
tr { display: table-row; }
td { display: table-cell; }
table { display: table; }
em { font-style: italic; }
strong { font-weight: bold; }
.hidden { display: none; }
