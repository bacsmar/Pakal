<rml>
<head>
	<title>Dungeon menu</title>
	<link type="text/rcss" href="../../ui/base.rcss"/>
	<link type="text/rcss" href="../../ui/zombies.rcss"/>
	<link type="text/rcss" href="menu.rcss"/>
</head>
<!-- The dungeon's first screen (DungeonMenuState): alone, host, or join a game found on this network -->
<body id="dungeon_menu">
	<div id="m_panel">
		<div id="m_title" class="title">THE DUNGEON</div>
		<div id="m_alone" class="button">PLAY ALONE</div>
		<div id="m_host" class="button">HOST A GAME</div>
		<div class="m_heading title">GAMES ON THIS NETWORK</div>
		<div id="m_games"></div>
		<div id="m_device"></div>
	</div>
</body>
</rml>
