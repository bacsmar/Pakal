{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "win64",
      "displayName": "Windows x64 (MSVC, vcpkg)",
      "description": "Run from a Developer shell (vcvars64). Requires vcpkg at VCPKG_ROOT.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-win64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (GCC or Clang, vcpkg)",
      "description": "Requires vcpkg at VCPKG_ROOT.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    }
  ],
  "buildPresets": [
    { "name": "win64-release", "configurePreset": "win64", "configuration": "Release" },
    { "name": "linux-release", "configurePreset": "linux", "configuration": "Release" }
  ]
}
